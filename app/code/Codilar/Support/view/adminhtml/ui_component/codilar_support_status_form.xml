<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">codilar_support_status_form.codilar_support_status_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Status</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Codilar\Support\Block\Adminhtml\Edit\BackButton"/>
            <button name="delete" class="Codilar\Support\Block\Adminhtml\Edit\DeleteButton"/>
            <button name="save_and_continue" class="Codilar\Support\Block\Adminhtml\Edit\SaveAndContinueButton"/>
            <button name="save" class="Codilar\Support\Block\Adminhtml\Edit\SaveButton"/>
        </buttons>
        <namespace>codilar_support_status_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>codilar_support_status_form.codilar_support_status_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="codilar_support_status_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="codilar_support/status/save"/>
        </settings>
        <dataProvider class="Codilar\Support\Model\Status\DataProvider" name="codilar_support_status_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>status_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label/>
        </settings>
        <field name="status_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>status_id</dataScope>
            </settings>
        </field>
        <field name="code" sortOrder="10" formElement="input">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="validate-code" xsi:type="boolean">true</rule>
                    <rule name="max_text_length" xsi:type="number">32</rule>
                </validation>
                <notice translate="true">Lowercase letters, numbers and underscores, starting with a letter. Cannot be changed after the status is created.</notice>
                <dataType>text</dataType>
                <label translate="true">Code</label>
                <dataScope>code</dataScope>
            </settings>
        </field>
        <field name="label" sortOrder="20" formElement="input">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="max_text_length" xsi:type="number">255</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Label</label>
                <dataScope>label</dataScope>
            </settings>
        </field>
        <field name="sort_order" sortOrder="30" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="number">0</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Sort Order</label>
                <dataScope>sort_order</dataScope>
            </settings>
        </field>
        <field name="is_active" sortOrder="40" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Active</label>
                <dataScope>is_active</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
    </fieldset>
</form>
