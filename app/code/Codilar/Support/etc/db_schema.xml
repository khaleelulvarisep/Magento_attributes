<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <!-- Existing table: request_id, customer_name, email, message are declared exactly as they already exist -->
    <table name="codilar_support_request" resource="default" engine="innodb" comment="Customer Support Requests">
        <column xsi:type="int" name="request_id" unsigned="true" nullable="false" identity="true" comment="Request ID"/>
        <column xsi:type="varchar" name="customer_name" length="255" nullable="false" comment="Customer Name"/>
        <column xsi:type="varchar" name="email" length="255" nullable="false" comment="Customer Email"/>
        <column xsi:type="varchar" name="subject" length="255" nullable="false" default="" comment="Subject"/>
        <column xsi:type="text" name="message" nullable="false" comment="Support Message"/>
        <column xsi:type="varchar" name="status" length="32" nullable="false" default="pending" comment="Status Code"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="request_id"/>
        </constraint>
        <index referenceId="CODILAR_SUPPORT_REQUEST_STATUS" indexType="btree">
            <column name="status"/>
        </index>
        <index referenceId="CODILAR_SUPPORT_REQUEST_FULLTEXT" indexType="fulltext">
            <column name="customer_name"/>
            <column name="email"/>
            <column name="subject"/>
            <column name="message"/>
        </index>
    </table>

    <table name="codilar_support_status" resource="default" engine="innodb" comment="Support Request Statuses">
        <column xsi:type="int" name="status_id" unsigned="true" nullable="false" identity="true" comment="Status ID"/>
        <column xsi:type="varchar" name="code" length="32" nullable="false" comment="Status Code"/>
        <column xsi:type="varchar" name="label" length="255" nullable="false" comment="Status Label"/>
        <column xsi:type="smallint" name="sort_order" unsigned="true" nullable="false" default="0" comment="Sort Order"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Is Active"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="status_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="CODILAR_SUPPORT_STATUS_CODE">
            <column name="code"/>
        </constraint>
    </table>
</schema>
