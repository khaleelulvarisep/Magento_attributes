             resource="Codilar_Support::requests"/>
        <add id="Codilar_Support::request_add"
             title="Add New Request"
             translate="title"
             module="Codilar_Support"
             sortOrder="20"
             parent="Codilar_Support::support"
             action="codilar_support/request/new"
             resource="Codilar_Support::request_save"/>
        <add id="Codilar_Support::statuses"
             title="Manage Statuses"
             translate="title"
             module="Codilar_Support"
             sortOrder="30"
             parent="Codilar_Support::support"
